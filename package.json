{
  "name": "pi-block-editor",
  "version": "0.1.0",
  "description": "Borderless, theme-aware block input editor for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/M1racleShih/pi-block-editor.git"
  },
  "homepage": "https://github.com/M1racleShih/pi-block-editor#readme",
  "bugs": "https://github.com/M1racleShih/pi-block-editor/issues",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "editor"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "examples/",
    "docs/",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "npm run check && npm test",
    "package:check": "npm pack --dry-run"
  }
}
